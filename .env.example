# Copy to .env (used automatically by docker compose) and adjust as needed.

# Host port for the backend API.
BACKEND_PORT=8000

# Host port for the frontend (nginx).
FRONTEND_PORT=8080

# Optional overrides. By default CORS_ORIGINS follows FRONTEND_PORT and
# VITE_API_BASE follows BACKEND_PORT.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# VITE_API_BASE=http://localhost:8000
