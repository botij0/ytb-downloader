# Copy to .env (used automatically by docker compose) and adjust as needed.

# Host port for the frontend (nginx). Open http://<host-ip>:<port>/.
FRONTEND_PORT=8080

# Host port for direct backend access. The browser UI does not need this:
# nginx proxies /api/* to the backend container.
BACKEND_PORT=8000

# Optional overrides.
# Leave VITE_API_BASE unset/empty for same-origin API calls (recommended).
# Set it only when the API is served from a different origin, then add the
# frontend origin to CORS_ORIGINS.
# VITE_API_BASE=http://api.example.test
# CORS_ORIGINS=http://192.168.1.147:8088
